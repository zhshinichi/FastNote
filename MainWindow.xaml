<Window x:Class="FastNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:FastNote"
        Title="FastNote" Height="724" Width="1040" MinWidth="780" MinHeight="580"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="#F3F4F7" Icon="app.ico"
        FontFamily="{DynamicResource UiFont}" FontSize="13.5" Foreground="#171C26"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- 2026-11 restyle ("方案 A"): search lives in the caption bar, the composer is
         shorter, the unfinished column is the hero (white cards on a cool grey
         canvas), the finished column recedes into plain rows, and every action sits
         in its column header as an icon. Fonts (HarmonyOS Sans SC, shipped in
         Fonts\ next to the exe) are installed as app resources by UiFonts.Install. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Palette: one blue accent, cool neutrals. -->
        <SolidColorBrush x:Key="Ink" Color="#171C26"/>
        <SolidColorBrush x:Key="Ink2" Color="#4A5363"/>
        <SolidColorBrush x:Key="Muted" Color="#868F9F"/>
        <SolidColorBrush x:Key="Faint" Color="#B4BBC7"/>
        <SolidColorBrush x:Key="Accent" Color="#2F5BEA"/>
        <SolidColorBrush x:Key="AccentDeep" Color="#2448C4"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#EAF0FE"/>
        <!-- 问题 (a record that is finished by answering it): violet, apart from tag blue -->
        <SolidColorBrush x:Key="QuestionInk" Color="#6A4BD8"/>
        <SolidColorBrush x:Key="QuestionSoft" Color="#F0ECFD"/>
        <SolidColorBrush x:Key="QuestionRing" Color="#A897F2"/>
        <SolidColorBrush x:Key="Line" Color="#E6E8EE"/>
        <SolidColorBrush x:Key="Hover" Color="#E8EAEF"/>
        <SolidColorBrush x:Key="Sheet" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DoneGreen" Color="#2E9E6B"/>
        <SolidColorBrush x:Key="DoneGreenSoft" Color="#D8EFE3"/>
        <!-- The open column switches to these while it is showing 搁置 records. -->
        <SolidColorBrush x:Key="OpenPillBg" Color="Transparent"/>
        <SolidColorBrush x:Key="ShelvePillBg" Color="#FDF1DE"/>
        <SolidColorBrush x:Key="ShelveInk" Color="#9A6408"/>

        <!-- Reading text sizes (rescaled by the A button / Ctrl+wheel). -->
        <sys:Double x:Key="FsCard">14.5</sys:Double>
        <sys:Double x:Key="FsCardLine">23</sys:Double>
        <sys:Double x:Key="FsCardMax">46</sys:Double>
        <sys:Double x:Key="FsMeta">12</sys:Double>
        <sys:Double x:Key="FsCompact">13.5</sys:Double>
        <sys:Double x:Key="FsCompactTime">11.5</sys:Double>
        <sys:Double x:Key="FsComposer">15</sys:Double>
        <sys:Double x:Key="FsGroup">13</sys:Double>
        <sys:Double x:Key="FsGroupSmall">11.5</sys:Double>
        <sys:Double x:Key="FsGroupFooter">12</sys:Double>

        <!-- Shared icon geometry (16x16 grid). -->
        <Geometry x:Key="IconCheck">M 3 8.6 L 6.6 12 L 13 4.6</Geometry>
        <Geometry x:Key="IconEdit">M 10.6 2.9 L 13.1 5.4 L 5.9 12.6 L 2.9 13.1 L 3.4 10.1 Z M 9.2 4.3 L 11.7 6.8</Geometry>
        <Geometry x:Key="IconCopy">M 6.9 5.6 H 12.1 A 1.5 1.5 0 0 1 13.6 7.1 V 12.3 A 1.5 1.5 0 0 1 12.1 13.8 H 6.9 A 1.5 1.5 0 0 1 5.4 12.3 V 7.1 A 1.5 1.5 0 0 1 6.9 5.6 Z M 3 10.4 V 3.9 A 1.6 1.6 0 0 1 4.6 2.3 H 10.4</Geometry>
        <Geometry x:Key="IconTrash">M 2.6 4.3 H 13.4 M 6.3 4.3 V 2.7 H 9.7 V 4.3 M 4 4.3 L 4.7 12.9 A 1.1 1.1 0 0 0 5.8 13.9 H 10.2 A 1.1 1.1 0 0 0 11.3 12.9 L 12 4.3 M 6.8 7 V 11.2 M 9.2 7 V 11.2</Geometry>
        <Geometry x:Key="IconRestore">M 5.4 3 L 2.4 6 L 5.4 9 M 2.6 6 H 9.6 A 3.4 3.4 0 0 1 9.6 12.8 H 7</Geometry>
        <Geometry x:Key="IconImage">M 3.6 3 H 12.4 A 1.6 1.6 0 0 1 14 4.6 V 11.4 A 1.6 1.6 0 0 1 12.4 13 H 3.6 A 1.6 1.6 0 0 1 2 11.4 V 4.6 A 1.6 1.6 0 0 1 3.6 3 Z M 2.4 11 L 5.8 8 L 8.5 10.4 L 10.5 8.7 L 13.6 11.2 M 6.9 6.3 A 1.15 1.15 0 1 0 4.6 6.3 A 1.15 1.15 0 1 0 6.9 6.3 Z</Geometry>
        <Geometry x:Key="IconPaste">M 5.6 2.8 H 4.6 A 1.6 1.6 0 0 0 3 4.4 V 12.4 A 1.6 1.6 0 0 0 4.6 14 H 11.4 A 1.6 1.6 0 0 0 13 12.4 V 4.4 A 1.6 1.6 0 0 0 11.4 2.8 H 10.4 M 6.5 1.7 H 9.5 A 0.9 0.9 0 0 1 10.4 2.6 V 3.1 A 0.9 0.9 0 0 1 9.5 4 H 6.5 A 0.9 0.9 0 0 1 5.6 3.1 V 2.6 A 0.9 0.9 0 0 1 6.5 1.7 Z</Geometry>
        <Geometry x:Key="IconStar">M 8.00 1.60 L 9.73 6.01 L 14.47 6.30 L 10.81 9.31 L 12.00 13.90 L 8.00 11.35 L 4.00 13.90 L 5.19 9.31 L 1.53 6.30 L 6.27 6.01 Z</Geometry>
        <Geometry x:Key="IconShelve">M 3 8.8 V 12.2 A 1.7 1.7 0 0 0 4.7 13.9 H 11.3 A 1.7 1.7 0 0 0 13 12.2 V 8.8 M 8 2.4 V 9 M 5.3 6.3 L 8 9 L 10.7 6.3</Geometry>
        <Geometry x:Key="IconCalendar">M 2.2 3 A 1.2 1.2 0 0 1 3.4 1.8 H 11.6 A 1.2 1.2 0 0 1 12.8 3 V 12.2 A 1.2 1.2 0 0 1 11.6 13.4 H 3.4 A 1.2 1.2 0 0 1 2.2 12.2 Z M 2.2 5.9 H 12.8 M 5.1 1.4 V 3.2 M 9.9 1.4 V 3.2</Geometry>
        <Geometry x:Key="IconSummary">M 3 4.2 H 13 M 3 8 H 13 M 3 11.8 H 9.4</Geometry>
        <Geometry x:Key="IconFolder">M 2.2 4.4 A 1.3 1.3 0 0 1 3.5 3.1 H 6.3 L 7.8 4.7 H 12.5 A 1.3 1.3 0 0 1 13.8 6 V 11.6 A 1.3 1.3 0 0 1 12.5 12.9 H 3.5 A 1.3 1.3 0 0 1 2.2 11.6 Z</Geometry>
        <Geometry x:Key="IconLabel">M 2.6 2.6 H 7 C 7.6 2.6 8.2 2.9 8.6 3.3 L 13.4 8.1 C 14 8.7 14 9.6 13.4 10.2 L 10.2 13.4 C 9.6 14 8.7 14 8.1 13.4 L 3.3 8.6 C 2.9 8.2 2.6 7.6 2.6 7 Z M 5.6 4.3 A 1.2 1.2 0 1 0 5.6 6.7 A 1.2 1.2 0 1 0 5.6 4.3 Z</Geometry>

        <!-- ============================================================ scrollbars -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumb" CornerRadius="3" Background="#D2D7DF" Margin="2,1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="#AAB2BF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="#8E98A8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="pageForward" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="pageBack" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="pageForward" Property="Command" Value="ScrollBar.PageRightCommand"/>
                                <Setter TargetName="pageBack" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ buttons -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="shell" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Hover}"/>
                    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#DDE1E8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FBEDEE"/>
                    <Setter Property="Foreground" Value="#C2414B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Square-ish glyph buttons used in the column headers and composer toolbar. -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="#6A7383"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style x:Key="DeleteIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FBEDEE"/>
                    <Setter Property="Foreground" Value="#C2414B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="FontFamily" Value="{DynamicResource UiFontMedium}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="shell" CornerRadius="9" Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="{StaticResource AccentDeep}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="#1E3CA6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="shell" Property="Background" Value="#BCC8F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#7A8394"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="shell" Width="36" Height="30" CornerRadius="7" Background="Transparent">
                            <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Canvas.Left="4.9" Canvas.Top="1" Width="6.2" Height="6.2"
                                         Fill="{TemplateBinding Foreground}"/>
                                <Rectangle Canvas.Left="3.6" Canvas.Top="5.9" Width="8.8" Height="2.4"
                                           RadiusX="1.2" RadiusY="1.2" Fill="{TemplateBinding Foreground}"/>
                                <Rectangle Canvas.Left="7.3" Canvas.Top="8" Width="1.4" Height="4.8"
                                           RadiusX="0.7" RadiusY="0.7" Fill="{TemplateBinding Foreground}"/>
                            </Canvas>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="{StaticResource Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#5A6374"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="shell" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="{StaticResource Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="#DDE1E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="shell" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="#C50F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="#B9CBF7"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ pills -->
        <!-- One shape for every toggle in the toolbars: borderless, tinted when on. -->
        <Style x:Key="WeekPill" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#6A7383"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="shell" Height="28" CornerRadius="8" Background="Transparent" Padding="8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconCalendar}"
                                      Fill="Transparent" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center"/>
                                <ContentPresenter Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="{StaticResource Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentDeep}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShelvePill" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#6A7383"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="shell" Height="28" CornerRadius="8" Background="Transparent" Padding="8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconShelve}"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center"/>
                                <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="{StaticResource Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="{StaticResource ShelvePillBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource ShelveInk}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StarFilterPill" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#6A7383"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="shell" Height="28" CornerRadius="8" Background="Transparent" Padding="8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="glyph" Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconStar}"
                                      Fill="Transparent" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                      StrokeLineJoin="Round" VerticalAlignment="Center"/>
                                <ContentPresenter Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="{StaticResource Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="#FDF3DC"/>
                                <Setter TargetName="glyph" Property="Fill" Value="#F2A91C"/>
                                <Setter TargetName="glyph" Property="Stroke" Value="#E09A0C"/>
                                <Setter Property="Foreground" Value="#9A6408"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FontPill" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#6A7383"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="shell" Height="28" CornerRadius="8" Background="Transparent" Padding="8,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="{StaticResource Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="#DDE1E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tag chips are built in code; colours are painted by ApplyChipColors. -->
        <Style x:Key="TagChipButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource Ink2}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="shell" CornerRadius="14" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStripToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#6A7383"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="shell" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource IconSummary}"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Path x:Name="chevron" Data="M 1 2 L 4.5 5.5 L 8 2" Width="9" Height="8"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Margin="5,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="{StaticResource Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentDeep}"/>
                                <Setter TargetName="chevron" Property="Data" Value="M 1 5.5 L 4.5 2 L 8 5.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ card parts -->
        <Style x:Key="CardIconButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="7" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF1F5"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E3E7EE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardStarButton" TargetType="Button" BasedOn="{StaticResource CardIconButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FDF4E2"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FBEACB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StarToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="shell" Width="26" Height="26" CornerRadius="13" Background="Transparent">
                            <Path x:Name="glyph" Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconStar}"
                                  Fill="Transparent" Stroke="#CBD1DB" StrokeThickness="1.25" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="#FDF4E2"/>
                                <Setter TargetName="glyph" Property="Stroke" Value="#DFA83C"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="glyph" Property="Fill" Value="#F2A91C"/>
                                <Setter TargetName="glyph" Property="Stroke" Value="#E09A0C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardCheckButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="hover" Background="Transparent" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Background" Value="{StaticResource AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ list items -->
        <!-- Open records: a white sheet on the grey canvas. The "shadow" is a second,
             darker sheet 2px lower: crisp, and unlike DropShadowEffect it keeps ClearType. -->
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Preview}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border CornerRadius="12" Background="#0E1B2638" Margin="1,2,1,-2"/>
                            <Border x:Name="card" CornerRadius="12" Background="#FFFFFF"
                                    BorderBrush="#E7E9EE" BorderThickness="1"
                                    Padding="14,13,10,11" Cursor="Hand">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="#D3D8E1"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Done}" Value="True">
                                <Setter TargetName="card" Property="Background" Value="#F8F9FB"/>
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="card" Property="Background" Value="#FBFCFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Finished records: no card, just a quiet row so they step back. -->
        <Style x:Key="DoneRowItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Preview}"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" CornerRadius="9" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" Padding="8,8,4,8" Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#F5F6F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="row" Property="BorderBrush" Value="#C9D5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactCardItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Preview}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" CornerRadius="8" Background="Transparent" Padding="4,5,3,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#F3F4F7"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{StaticResource AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One menu shared by every card (built once, see the note in the code). -->
        <ContextMenu x:Key="CardContextMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     Opened="CardMenu_Opened">
            <MenuItem Header="编辑" InputGestureText="F2" Click="CardEditMenu_Click"/>
            <MenuItem Header="复制" Click="CardCopyMenu_Click"/>
            <MenuItem Header="加星标" Tag="starmenu" Click="CardStarMenu_Click"/>
            <MenuItem Header="搁置" Tag="shelvemenu" InputGestureText="Ctrl+Shift+P" Click="CardShelveMenu_Click"/>
            <MenuItem Header="标签" Tag="tagmenu"/>
            <MenuItem Header="摘要" Tag="labelmenu"/>
            <MenuItem Header="完成" Tag="donemenu" Click="CardToggleMenu_Click"/>
            <MenuItem Header="设为问题" Tag="questionmenu" InputGestureText="Ctrl+Shift+Q" Click="CardQuestionMenu_Click"/>
            <MenuItem Header="写回答…" Tag="answermenu" Click="CardAnswerMenu_Click"/>
            <Separator/>
            <MenuItem Header="删除" InputGestureText="Delete" Foreground="#C0392B"
                      Click="CardDeleteMenu_Click"/>
        </ContextMenu>

        <ContextMenu x:Key="CompactCardContextMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     Opened="CardMenu_Opened">
            <MenuItem Header="编辑" InputGestureText="F2" Click="CardEditMenu_Click"/>
            <MenuItem Header="复制" Click="CardCopyMenu_Click"/>
            <MenuItem Header="加星标" Tag="starmenu" Click="CardStarMenu_Click"/>
            <MenuItem Header="搁置" Tag="shelvemenu" InputGestureText="Ctrl+Shift+P" Click="CardShelveMenu_Click"/>
            <MenuItem Header="标签" Tag="tagmenu"/>
            <MenuItem Header="摘要" Tag="labelmenu"/>
            <MenuItem Header="完成" Tag="donemenu" Click="CardToggleMenu_Click"/>
            <MenuItem Header="设为问题" Tag="questionmenu" InputGestureText="Ctrl+Shift+Q" Click="CardQuestionMenu_Click"/>
            <MenuItem Header="写回答…" Tag="answermenu" Click="CardAnswerMenu_Click"/>
            <Separator/>
            <MenuItem Header="删除" InputGestureText="Delete" Foreground="#C0392B"
                      Click="CardDeleteMenu_Click"/>
        </ContextMenu>

        <!-- ============================================================ templates -->
        <DataTemplate x:Key="CardTemplate">
            <Grid ContextMenu="{StaticResource CardContextMenu}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CardComplete" Width="28" Height="28" Margin="-5,-3,6,0"
                        VerticalAlignment="Top" Style="{StaticResource CardCheckButton}"
                        ToolTip="{Binding CompleteHint}" AutomationProperties.Name="完成" Click="CardComplete_Click">
                  <Grid x:Name="checkGlyph" Width="18" Height="18" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="checkScale" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                    <Ellipse x:Name="ring" Fill="#FFFFFF" Stroke="#B3BAC6" StrokeThickness="1.6"/>
                    <!-- Dash length is in pen-thickness units: 8.07 x 2px covers the 16.14px tick. -->
                    <Path x:Name="tick" Data="M 3.5 9 L 7.2 12.6 L 14.5 4.4" Stroke="White"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeDashArray="8.07,8.07" StrokeDashOffset="8.07" Visibility="Collapsed"/>
                  </Grid>
                </Button>
                <StackPanel Grid.Column="1" Margin="0,0,4,0">
                    <TextBlock x:Name="title" Text="{Binding Preview}" TextWrapping="Wrap"
                               FontSize="{DynamicResource FsCard}"
                               MaxHeight="{DynamicResource FsCardMax}" LineHeight="{DynamicResource FsCardLine}"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource Ink}"/>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding Meta}" FontSize="{DynamicResource FsMeta}"
                                   Foreground="{StaticResource Muted}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <!-- Only shown while a search pulls shelved records in. -->
                        <StackPanel x:Name="shelveTag" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,12,0">
                            <Ellipse Width="6" Height="6" Fill="#E3A23A" VerticalAlignment="Center" Margin="0,1,5,0"/>
                            <TextBlock Text="搁置" FontSize="{DynamicResource FsMeta}" Foreground="{StaticResource ShelveInk}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- 问题 = finished by answering: a violet chip that says what is missing. -->
                        <Border x:Name="questionBadge" Visibility="Collapsed" Background="{StaticResource QuestionSoft}"
                                CornerRadius="6" Padding="6,1,7,2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="questionBadgeText" Text="待回答" FontSize="{DynamicResource FsMeta}"
                                       Foreground="{StaticResource QuestionInk}" FontFamily="{DynamicResource UiFontMedium}"
                                       FontWeight="Medium" VerticalAlignment="Center"/>
                        </Border>
                        <!-- 标签 = the folder this record lives in: a filled blue chip. -->
                        <Border x:Name="tagBadge" Visibility="Collapsed" Background="{StaticResource AccentSoft}"
                                CornerRadius="6" Padding="6,1,8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource IconFolder}"
                                      Fill="#C9D6FB" Stroke="{StaticResource Accent}" StrokeThickness="1.2" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,1,5,0"/>
                                <TextBlock Text="{Binding Tag}" FontSize="{DynamicResource FsMeta}" Foreground="{StaticResource AccentDeep}"
                                           FontFamily="{DynamicResource UiFontMedium}" FontWeight="Medium"
                                           MaxWidth="140" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tag}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- 摘要 = what it is about: plain grey text behind a "lines" mark, no fill. -->
                        <StackPanel x:Name="labelBadge" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,10,0"
                                    VerticalAlignment="Center" ToolTip="{Binding Label}">
                            <Path Width="11" Height="11" Stretch="Uniform" Data="{StaticResource IconSummary}"
                                  Stroke="{StaticResource Muted}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" Margin="0,1,5,0"/>
                            <TextBlock Text="{Binding Label}" FontSize="{DynamicResource FsMeta}" Foreground="{StaticResource Ink2}"
                                       MaxWidth="170" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>
                    <!-- an answer written earlier (saved, or kept after 恢复) -->
                    <DockPanel x:Name="answerLine" Visibility="Collapsed" Margin="0,6,0,0">
                        <Border DockPanel.Dock="Left" Background="{StaticResource QuestionSoft}" CornerRadius="4"
                                Padding="4,0,4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="答" FontSize="11" Foreground="{StaticResource QuestionInk}"
                                       FontFamily="{DynamicResource UiFontMedium}" FontWeight="Medium"/>
                        </Border>
                        <TextBlock Text="{Binding AnswerPreview}" FontSize="{DynamicResource FsMeta}" Foreground="{StaticResource Ink2}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,-4,-2,0" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <Button x:Name="CardStar" Width="26" Height="26" Style="{StaticResource CardStarButton}"
                            Click="CardStar_Click"
                            AutomationProperties.Name="星标"
                            ToolTip="星标">
                        <Path x:Name="starGlyph" Width="15" Height="15" Stretch="Uniform" Data="{StaticResource IconStar}"
                              Fill="Transparent" Stroke="#C6CCD6" StrokeThickness="1.25" StrokeLineJoin="Round"/>
                    </Button>
                    <!-- 摘要 button: appears on hover / selection, or when a gist is set. -->
                    <Button x:Name="CardLabelButton" Width="26" Height="26" Margin="0,1,0,0" Visibility="Collapsed"
                            Style="{StaticResource CardIconButton}" Click="CardLabelButton_Click"
                            AutomationProperties.Name="摘要"
                            ToolTip="摘要">
                        <Path x:Name="labelGlyph" Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconSummary}"
                              Fill="Transparent" Stroke="#AEB5C1" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <!-- 问题 switch: appears on hover / selection, stays lit on questions. -->
                    <Button x:Name="CardQuestionButton" Width="26" Height="26" Margin="0,1,0,0" Visibility="Collapsed"
                            Style="{StaticResource CardIconButton}" Click="CardQuestion_Click"
                            AutomationProperties.Name="设为问题"
                            ToolTip="设为问题 · Ctrl+Shift+Q">
                        <TextBlock x:Name="questionGlyph" Text="?" FontSize="14" FontWeight="Bold" Foreground="#AEB5C1"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                    </Button>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="CardLabelButton" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="CardQuestionButton" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="starGlyph" Property="Stroke" Value="#9AA3B1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="CardLabelButton" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="CardQuestionButton" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsQuestion}" Value="True">
                    <Setter TargetName="questionBadge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="CardQuestionButton" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="CardQuestionButton" Property="ToolTip" Value="取消问题 · Ctrl+Shift+Q"/>
                    <Setter TargetName="questionGlyph" Property="Foreground" Value="{StaticResource QuestionInk}"/>
                    <Setter TargetName="ring" Property="Stroke" Value="{StaticResource QuestionRing}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasAnswer}" Value="True">
                    <Setter TargetName="answerLine" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="questionBadgeText" Property="Text" Value="已回答"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Starred}" Value="True">
                    <Setter TargetName="starGlyph" Property="Fill" Value="#F2A91C"/>
                    <Setter TargetName="starGlyph" Property="Stroke" Value="#E09A0C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Shelved}" Value="True">
                    <Setter TargetName="shelveTag" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasTag}" Value="True">
                    <Setter TargetName="tagBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasLabel}" Value="True">
                    <Setter TargetName="labelBadge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="CardLabelButton" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="labelGlyph" Property="Stroke" Value="{StaticResource Ink2}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="CardComplete" Property="IsEnabled" Value="False"/>
                    <Setter TargetName="CardComplete" Property="ToolTip" Value="已完成"/>
                    <Setter TargetName="ring" Property="Fill" Value="#AEB5C1"/>
                    <Setter TargetName="ring" Property="Stroke" Value="#AEB5C1"/>
                    <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="tick" Property="StrokeDashOffset" Value="0"/>
                    <Setter TargetName="title" Property="Foreground" Value="#6B7383"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Finished column, normal mode: one line per record. -->
        <DataTemplate x:Key="DoneRowTemplate">
            <Grid ContextMenu="{StaticResource CardContextMenu}" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="DoneTick" Width="16" Height="16" Margin="1,0,11,0" VerticalAlignment="Center">
                    <Ellipse Fill="#5DB68C"/>
                    <Path Data="M 4.3 8.3 L 7 10.9 L 11.8 5.5" Stroke="White" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="DoneTitle" Text="{Binding Preview}"
                               FontSize="{DynamicResource FsCompact}" TextTrimming="CharacterEllipsis"
                               Foreground="#4A5363"/>
                    <!-- a question keeps its answer in view -->
                    <DockPanel x:Name="DoneAnswer" Visibility="Collapsed" Margin="0,3,0,1">
                        <Border DockPanel.Dock="Left" Background="{StaticResource QuestionSoft}" CornerRadius="4"
                                Padding="4,0,4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="答" FontSize="11" Foreground="{StaticResource QuestionInk}"
                                       FontFamily="{DynamicResource UiFontMedium}" FontWeight="Medium"/>
                        </Border>
                        <TextBlock Text="{Binding AnswerPreview}" FontSize="{DynamicResource FsMeta}" Foreground="{StaticResource Ink2}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
                <TextBlock x:Name="DoneTime" Grid.Column="2" Text="{Binding ShortTime}" Margin="12,0,4,0"
                           FontSize="{DynamicResource FsCompactTime}" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center"/>
                <Button x:Name="CardStar" Grid.Column="3" Width="24" Height="24" Opacity="0" VerticalAlignment="Center"
                        Style="{StaticResource CardStarButton}" Click="CardStar_Click"
                        AutomationProperties.Name="星标" ToolTip="星标">
                    <Path x:Name="starGlyph" Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconStar}"
                          Fill="Transparent" Stroke="#9AA3B1" StrokeThickness="1.25" StrokeLineJoin="Round"/>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="CardStar" Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="CardStar" Property="Opacity" Value="1"/>
                    <Setter TargetName="DoneTitle" Property="Foreground" Value="{StaticResource Ink2}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasAnswer}" Value="True">
                    <Setter TargetName="DoneAnswer" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="DoneTick" Property="VerticalAlignment" Value="Top"/>
                    <Setter TargetName="DoneTick" Property="Margin" Value="1,2,11,0"/>
                    <Setter TargetName="DoneTime" Property="VerticalAlignment" Value="Top"/>
                    <Setter TargetName="DoneTime" Property="Margin" Value="12,2,4,0"/>
                    <Setter TargetName="CardStar" Property="VerticalAlignment" Value="Top"/>
                    <Setter TargetName="CardStar" Property="Margin" Value="0,-3,0,0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Starred}" Value="True">
                    <Setter TargetName="CardStar" Property="Opacity" Value="1"/>
                    <Setter TargetName="starGlyph" Property="Fill" Value="#F2A91C"/>
                    <Setter TargetName="starGlyph" Property="Stroke" Value="#E09A0C"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Grouped mode: one line per record, inside its week card. -->
        <DataTemplate x:Key="CompactCardTemplate">
            <Grid ContextMenu="{StaticResource CompactCardContextMenu}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CardComplete" Width="26" Height="26" Margin="-5,-2,5,0" VerticalAlignment="Center"
                        Style="{StaticResource CardCheckButton}"
                        ToolTip="{Binding CompleteHint}" AutomationProperties.Name="完成" Click="CardComplete_Click">
                    <Grid x:Name="checkGlyph" Width="18" Height="18" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="checkScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Ellipse x:Name="ring" Fill="#FFFFFF" Stroke="#B3BAC6" StrokeThickness="1.6"/>
                        <Path x:Name="tick" Data="M 3.5 9 L 7.2 12.6 L 14.5 4.4" Stroke="White"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeDashArray="8.07,8.07" StrokeDashOffset="8.07" Visibility="Collapsed"/>
                    </Grid>
                </Button>
                <DockPanel Grid.Column="1" VerticalAlignment="Center">
                    <Border x:Name="compactQuestion" DockPanel.Dock="Left" Visibility="Collapsed"
                            Background="{StaticResource QuestionSoft}" CornerRadius="4" Padding="4,0,4,1" Margin="0,0,6,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="问" FontSize="11" Foreground="{StaticResource QuestionInk}"
                                   FontFamily="{DynamicResource UiFontMedium}" FontWeight="Medium"/>
                    </Border>
                    <TextBlock x:Name="CompactTitle" Text="{Binding Preview}"
                               FontSize="{DynamicResource FsCompact}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{StaticResource Ink}"/>
                </DockPanel>
                <TextBlock Grid.Column="2" Text="{Binding ShortTime}" Margin="10,0,4,0"
                           FontSize="{DynamicResource FsCompactTime}"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <Button x:Name="CardStar" Grid.Column="3" Width="26" Height="26"
                        Style="{StaticResource CardStarButton}" Click="CardStar_Click"
                        AutomationProperties.Name="星标" ToolTip="星标">
                    <Path x:Name="starGlyph" Width="13" Height="13" Stretch="Uniform" Data="{StaticResource IconStar}"
                          Fill="Transparent" Stroke="#C6CCD6" StrokeThickness="1.25" StrokeLineJoin="Round"/>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Starred}" Value="True">
                    <Setter TargetName="starGlyph" Property="Fill" Value="#F2A91C"/>
                    <Setter TargetName="starGlyph" Property="Stroke" Value="#E09A0C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsQuestion}" Value="True">
                    <Setter TargetName="compactQuestion" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ring" Property="Stroke" Value="{StaticResource QuestionRing}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="CardComplete" Property="IsEnabled" Value="False"/>
                    <Setter TargetName="ring" Property="Fill" Value="#B3BAC6"/>
                    <Setter TargetName="ring" Property="Stroke" Value="#B3BAC6"/>
                    <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="tick" Property="StrokeDashOffset" Value="0"/>
                    <Setter TargetName="CompactTitle" Property="Foreground" Value="#7B8393"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One card per ISO week: header (range, 本周/上周, count) + rows. -->
        <GroupStyle x:Key="WeekGroupStyle">
            <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GroupItem">
                                <Grid Margin="0,0,2,12">
                                    <Border CornerRadius="12" Background="#0E1B2638" Margin="1,2,1,-2"/>
                                    <Border Background="#FFFFFF" BorderBrush="#E7E9EE" BorderThickness="1"
                                            CornerRadius="12" Padding="10,10,10,8">
                                    <StackPanel>
                                        <Grid Margin="4,0,4,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name.Label}"
                                                           FontSize="{DynamicResource FsGroup}"
                                                           FontFamily="{DynamicResource UiFontMedium}" FontWeight="Medium"
                                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                                                <Border Background="{StaticResource AccentSoft}" CornerRadius="9" Padding="7,1,7,2"
                                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Name.Tag}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Name.Tag}"
                                                               FontSize="{DynamicResource FsGroupSmall}" Foreground="{StaticResource AccentDeep}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Name.CountText}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FsGroupSmall}" Foreground="{StaticResource Muted}"/>
                                        </Grid>
                                        <Border Height="1" Background="#EEF0F4" Margin="4,0,4,5"/>
                                        <ItemsPresenter/>
                                        <Button x:Name="WeekMoreButton" Margin="2,4,2,0" Padding="0"
                                                HorizontalContentAlignment="Left" Click="WeekOpen_Click"
                                                Cursor="Hand" Focusable="False" ToolTip="展开这一周"
                                                AutomationProperties.Name="{Binding Name.FooterText}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="moreShell" CornerRadius="7"
                                                                        Background="Transparent" Padding="7,5">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="moreShell" Property="Background" Value="{StaticResource AccentSoft}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Name.HasMore}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{Binding Name.FooterText}" FontSize="{DynamicResource FsGroupFooter}"/>
                                        </Button>
                                    </StackPanel>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GroupStyle.ContainerStyle>
        </GroupStyle>

        <Style x:Key="ListBoxBare" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,2,0,2"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CardItem}"/>
            <Setter Property="ItemTemplate" Value="{StaticResource CardTemplate}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False"
                                          CanContentScroll="{Binding Path=(ScrollViewer.CanContentScroll), RelativeSource={RelativeSource TemplatedParent}}"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Template>
                                    <ControlTemplate TargetType="ScrollViewer">
                                        <!-- The bar floats over the right gutter instead of taking a column,
                                             so the cards keep their width when it appears. -->
                                        <Grid>
                                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="0,0,12,0"
                                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                                    Content="{TemplateBinding Content}"
                                                                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                            <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Orientation="Vertical"
                                                       Style="{StaticResource {x:Type ScrollBar}}" Margin="0,0,-2,0"
                                                       Maximum="{TemplateBinding ScrollableHeight}"
                                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollViewer.Template>
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kept for compatibility with older code paths; same as the bare list now. -->
        <Style x:Key="OpenListLeftScroll" TargetType="ListBox" BasedOn="{StaticResource ListBoxBare}"/>

        <Style x:Key="CountPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="6,1,6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,1,0,0"/>
        </Style>

        <Style x:Key="ColumnTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="{DynamicResource UiFontMedium}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EmptyHint" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="18,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="HeaderIcon" TargetType="Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="1.35"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ caption bar -->
        <Grid x:Name="TitleBar" Grid.Row="0" Margin="22,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Width="20" Height="20" VerticalAlignment="Center">
                <Border CornerRadius="6" Background="{StaticResource Accent}"/>
                <Path Data="M 5.3 10.1 L 8.6 13.2 L 14.6 6.8" Stroke="White" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Grid>
            <TextBlock Grid.Column="1" Text="FastNote" Margin="10,0,0,1" VerticalAlignment="Center"
                       FontSize="14" FontFamily="{DynamicResource UiFontMedium}" FontWeight="Medium"
                       Foreground="{StaticResource Ink}"/>

            <!-- Search: in the caption bar so it costs no row of its own. -->
            <Border Grid.Column="2" Margin="30,0,20,0" Height="34" MaxWidth="420" HorizontalAlignment="Stretch"
                    VerticalAlignment="Center" Background="{StaticResource Sheet}" CornerRadius="9"
                    BorderThickness="1" Padding="11,0,6,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#D5DAE2"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#9DB4F3"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Width="16" Height="16" Stretch="None" Margin="0,0,8,0" VerticalAlignment="Center"
                          Data="M 11.6 6.8 A 4.8 4.8 0 1 0 2 6.8 A 4.8 4.8 0 1 0 11.6 6.8 M 10.4 10.4 L 14 14"
                          Stroke="{StaticResource Muted}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" VerticalContentAlignment="Center"
                                 FontSize="13" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchHint" Text="搜索" Foreground="{StaticResource Muted}"
                                   IsHitTestVisible="False" VerticalAlignment="Center" FontSize="13"/>
                    </Grid>
                    <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5"
                            Padding="6,0,6,1" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Ctrl F" FontSize="11" Foreground="{StaticResource Muted}"/>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="PinButton" Style="{StaticResource PinToggle}"
                              AutomationProperties.Name="置顶"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              Checked="PinButton_Toggled" Unchecked="PinButton_Toggled"
                              ToolTip="置顶"/>
                <Border Width="1" Height="16" Background="{StaticResource Line}" Margin="6,0" VerticalAlignment="Center"/>
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                        AutomationProperties.Name="最小化"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeButton_Click" ToolTip="最小化">
                    <Path Width="11" Height="11" Stretch="None" Data="M 0.5 5.5 L 10.5 5.5"
                          StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                        AutomationProperties.Name="最大化"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaximizeButton_Click" ToolTip="最大化">
                    <Grid Width="12" Height="12">
                        <Rectangle x:Name="MaxGlyph" Width="10" Height="9" RadiusX="1.8" RadiusY="1.8"
                                   StrokeThickness="1.1"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <Grid x:Name="RestoreGlyph" Width="11" Height="10" Visibility="Collapsed">
                            <Rectangle Width="8.5" Height="7.5" RadiusX="1.4" RadiusY="1.4"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" StrokeThickness="1.1"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <Rectangle Width="8.5" Height="7.5" RadiusX="1.4" RadiusY="1.4"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom" StrokeThickness="1.1"
                                       Fill="#F3F4F7"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Grid>
                    </Grid>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}"
                        AutomationProperties.Name="关闭"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseButton_Click" ToolTip="收到托盘">
                    <Path Width="11" Height="11" Stretch="None" Data="M 1.4 1.4 L 9.6 9.6 M 9.6 1.4 L 1.4 9.6"
                          StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="22,4,22,16">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ComposerRow" Height="128" MinHeight="120"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*" MinHeight="200"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ composer -->
        <Grid>
            <Border CornerRadius="14" Background="#0E1B2638" Margin="1,2,1,-2"/>
            <Border CornerRadius="14" BorderThickness="1" Padding="18,13,12,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Sheet}"/>
                        <Setter Property="BorderBrush" Value="#E4E7EC"/>
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#9DB4F3"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Only says something while an existing record is being edited. -->
                    <TextBlock x:Name="ComposerTitle" Text="随手记" FontSize="12"
                               FontFamily="{DynamicResource UiFontMedium}" FontWeight="Medium"
                               Foreground="{StaticResource Accent}" Margin="2,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="随手记">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid Grid.Row="1">
                        <RichTextBox x:Name="Composer" BorderThickness="0" Background="Transparent" Padding="0"
                                     Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Accent}"
                                     SelectionBrush="#B9CBF7"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     FontSize="{DynamicResource FsComposer}" PreviewKeyDown="Composer_PreviewKeyDown"/>
                        <TextBlock x:Name="ComposerHint" Text="记点什么…"
                                   Foreground="#9AA2B0" IsHitTestVisible="False" Margin="2,1,0,0"
                                   FontSize="{DynamicResource FsComposer}"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="-6,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ImageButton" ToolTip="添加图片" AutomationProperties.Name="添加图片"
                                    Style="{StaticResource IconButton}" Click="ImageButton_Click">
                                <Path Style="{StaticResource HeaderIcon}" Data="{StaticResource IconImage}"/>
                            </Button>
                            <Button x:Name="CopyComposerButton" ToolTip="复制" AutomationProperties.Name="复制"
                                    Style="{StaticResource IconButton}" Click="CopyComposerButton_Click">
                                <Path Style="{StaticResource HeaderIcon}" Data="{StaticResource IconCopy}"/>
                            </Button>
                            <Button x:Name="PasteButton" ToolTip="粘贴 · Ctrl+V" AutomationProperties.Name="粘贴"
                                    Style="{StaticResource IconButton}" Click="PasteButton_Click">
                                <Path Style="{StaticResource HeaderIcon}" Data="{StaticResource IconPaste}"/>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="ComposerShortcuts" Grid.Column="1" Text="Enter 记录 · Shift+Enter 换行" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="10,0,12,0"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CancelComposerEditButton" Content="取消编辑" ToolTip="放弃修改 · Esc"
                                    Style="{StaticResource QuietButton}" Padding="10,5" Margin="0,0,6,0"
                                    Visibility="Collapsed" Click="CancelComposerEditButton_Click"/>
                            <Button x:Name="AddButton" Content="记录" ToolTip="记录 · Enter"
                                    Style="{StaticResource PrimaryButton}" Padding="18,6" MinWidth="76" Click="AddButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="1" Height="14" HorizontalAlignment="Stretch"
                      Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Cursor="SizeNS" DragCompleted="Divider_DragCompleted" ToolTip="拖动调整高度">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Border x:Name="grip" Width="32" Height="3" CornerRadius="1.5" Background="#DADEE5" Margin="0,2,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="grip" Property="Background" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <!-- ============================================================ tag strip + filters -->
        <Grid Grid.Row="0" Margin="0,2,0,12" MinHeight="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="TagStripScroll" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled" Focusable="False"
                          PanningMode="HorizontalOnly" Margin="-4,0,0,0">
                <StackPanel x:Name="TagStrip" Orientation="Horizontal" VerticalAlignment="Center"/>
            </ScrollViewer>
            <ToggleButton x:Name="LabelToggle" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                          Visibility="Collapsed" Style="{StaticResource LabelStripToggle}"
                          AutomationProperties.Name="摘要" ToolTip="按摘要筛选"
                          Checked="LabelToggle_Toggled" Unchecked="LabelToggle_Toggled">
                <TextBlock x:Name="LabelToggleText" Text="摘要" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
            </ToggleButton>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <Border Width="1" Height="16" Background="{StaticResource Line}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <ToggleButton x:Name="StarFilter" VerticalAlignment="Center"
                              Style="{StaticResource StarFilterPill}"
                              Checked="StarFilter_Toggled" Unchecked="StarFilter_Toggled"
                              AutomationProperties.Name="只看星标"
                              ToolTip="只看星标 · Ctrl+Shift+S">
                    <TextBlock x:Name="StarCount" Text="0" FontSize="12.5"/>
                </ToggleButton>
                <ToggleButton x:Name="ShelveFilter" VerticalAlignment="Center"
                              Margin="2,0,0,0" Style="{StaticResource ShelvePill}"
                              Checked="ShelveFilter_Toggled" Unchecked="ShelveFilter_Toggled"
                              AutomationProperties.Name="只看搁置"
                              ToolTip="只看搁置">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="搁置" FontSize="12.5"/>
                        <TextBlock x:Name="ShelveCount" Text="0" FontSize="12.5" Margin="4,0,0,0"/>
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="FontButton" VerticalAlignment="Center"
                        Margin="2,0,0,0" Style="{StaticResource FontPill}"
                        AutomationProperties.Name="字号"
                        ToolTip="字号 · Ctrl+滚轮"
                        Click="FontButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="A" FontSize="13" FontFamily="{DynamicResource UiFontMedium}" FontWeight="Medium"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="FontValue" Text="14" FontSize="11" Margin="3,1,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="LabelBar" Grid.Row="1" Margin="0,-4,0,12" MinHeight="24" Visibility="Collapsed">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Focusable="False" Margin="-4,0,0,0">
                <StackPanel x:Name="LabelStrip" Orientation="Horizontal" VerticalAlignment="Center"/>
            </ScrollViewer>
        </Grid>

        <!-- ============================================================ two columns -->
        <Grid x:Name="ColumnHost" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OpenColumn" Width="*" MinWidth="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="DoneColumn" Width="*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="OpenColumnRoot" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <DockPanel x:Name="OpenHeaderRow" Margin="2,0,12,8" MinHeight="30" LastChildFill="True">
                        <Button x:Name="DeleteOpenButton" DockPanel.Dock="Right" ToolTip="删除 · Delete"
                                AutomationProperties.Name="删除" Style="{StaticResource DeleteIconButton}" Click="DeleteSelected_Click"
                                CommandParameter="{Binding SelectedItem, ElementName=OpenList}">
                            <Path Style="{StaticResource HeaderIcon}" Data="{StaticResource IconTrash}"/>
                        </Button>
                        <Button x:Name="CopyOpenButton" DockPanel.Dock="Right" ToolTip="复制"
                                AutomationProperties.Name="复制" Style="{StaticResource IconButton}" Click="CopyOpenButton_Click">
                            <Path Style="{StaticResource HeaderIcon}" Data="{StaticResource IconCopy}"/>
                        </Button>
                        <Button x:Name="EditOpenButton" DockPanel.Dock="Right" ToolTip="编辑 · F2"
                                AutomationProperties.Name="编辑" Style="{StaticResource IconButton}" Click="EditOpenButton_Click">
                            <Path Style="{StaticResource HeaderIcon}" Data="{StaticResource IconEdit}"/>
                        </Button>
                        <Button x:Name="CompleteButton" DockPanel.Dock="Right" ToolTip="完成 · Enter"
                                AutomationProperties.Name="完成" Style="{StaticResource IconButton}" Click="CompleteButton_Click">
                            <Path Style="{StaticResource HeaderIcon}" Data="{StaticResource IconCheck}" StrokeThickness="1.7"/>
                        </Button>
                        <Border DockPanel.Dock="Right" Width="1" Height="16" Background="{StaticResource Line}" Margin="6,0" VerticalAlignment="Center"/>
                        <!-- Grouping is per column: folding the left one must not fold
                             the finished column you are still reading. -->
                        <ToggleButton x:Name="OpenWeekToggle" DockPanel.Dock="Right"
                                      Style="{StaticResource WeekPill}"
                                      Checked="WeekMode_Toggled" Unchecked="WeekMode_Toggled"
                                      AutomationProperties.Name="未完成按周分组"
                                      ToolTip="按周分组">
                            <TextBlock Text="按周" FontSize="12.5"/>
                        </ToggleButton>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="OpenHeaderText" Text="未完成" Style="{StaticResource ColumnTitle}"
                                   Foreground="{StaticResource Ink}"/>
                        <Border x:Name="OpenCountPill" Style="{StaticResource CountPill}" Background="{StaticResource OpenPillBg}">
                            <TextBlock x:Name="OpenCount" Text="0" FontSize="13" Foreground="{StaticResource Muted}"/>
                        </Border>
                      </StackPanel>
                    </DockPanel>

                    <!-- Same slot, same height: a drilled week replaces the column header. -->
                    <DockPanel x:Name="OpenWeekBar" Margin="2,0,12,8" MinHeight="30" LastChildFill="False" Visibility="Collapsed">
                        <Button x:Name="OpenWeekBack" DockPanel.Dock="Left" Style="{StaticResource GhostButton}"
                                Padding="8,4" Margin="-8,0,0,0" Click="WeekBack_Click" ToolTip="返回 · Esc">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 6 1 L 1 6 L 6 11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="7" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="返回"/>
                            </StackPanel>
                        </Button>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock x:Name="OpenWeekTitle" FontSize="15" FontFamily="{DynamicResource UiFontMedium}" FontWeight="Medium"
                                       Foreground="{StaticResource Ink}"/>
                            <Border x:Name="OpenWeekTagBorder" Background="{StaticResource AccentSoft}" CornerRadius="9"
                                    Padding="7,1,7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="OpenWeekTag" FontSize="11.5" Foreground="{StaticResource AccentDeep}"/>
                            </Border>
                            <TextBlock x:Name="OpenWeekCount" FontSize="12.5" Foreground="{StaticResource Muted}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <ListBox x:Name="OpenList" Style="{StaticResource ListBoxBare}"
                             SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick"/>
                    <TextBlock x:Name="OpenEmpty" Style="{StaticResource EmptyHint}" Text="没有未完成的事项"/>
                </Grid>
            </Grid>

            <!-- A Thumb, not a GridSplitter: the drag only moves a guide line and the
                 columns snap once on release. -->
            <Thumb x:Name="ColumnDivider" Grid.Column="1" Width="26" HorizontalAlignment="Stretch" Background="Transparent"
                   Cursor="SizeWE" DragStarted="Divider_DragStarted" DragDelta="Divider_DragDelta"
                   DragCompleted="Divider_DragCompleted" ToolTip="拖动调整宽度">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <!-- The whole 26px strip is grabbable; the grip shows where. -->
                        <Grid Background="Transparent">
                            <Border x:Name="grip" Width="3" Height="30" CornerRadius="1.5" Background="#DFE2E8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="grip" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="grip" Property="Height" Value="64"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="grip" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="grip" Property="Height" Value="64"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- Both columns share one geometry: header row on the grey canvas, then the
                 list. The finished column's tinted panel sits only behind its list and
                 starts 2px down, exactly where the first open card starts (the list's
                 top padding), so the two top edges line up. -->
            <Grid x:Name="DoneColumnRoot" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <DockPanel x:Name="DoneHeaderRow" Margin="2,0,0,8" MinHeight="30" LastChildFill="True">
                        <Button x:Name="DeleteDoneButton" DockPanel.Dock="Right" ToolTip="删除 · Delete"
                                AutomationProperties.Name="删除" Style="{StaticResource DeleteIconButton}" Click="DeleteSelected_Click"
                                CommandParameter="{Binding SelectedItem, ElementName=DoneList}">
                            <Path Style="{StaticResource HeaderIcon}" Data="{StaticResource IconTrash}"/>
                        </Button>
                        <Button x:Name="CopyDoneButton" DockPanel.Dock="Right" ToolTip="复制"
                                AutomationProperties.Name="复制" Style="{StaticResource IconButton}" Click="CopyDoneButton_Click">
                            <Path Style="{StaticResource HeaderIcon}" Data="{StaticResource IconCopy}"/>
                        </Button>
                        <Button x:Name="RestoreButton" DockPanel.Dock="Right" ToolTip="恢复 · Enter"
                                AutomationProperties.Name="恢复" Style="{StaticResource IconButton}" Click="RestoreButton_Click">
                            <Path Style="{StaticResource HeaderIcon}" Data="{StaticResource IconRestore}"/>
                        </Button>
                        <Border DockPanel.Dock="Right" Width="1" Height="16" Background="{StaticResource Line}" Margin="6,0" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="DoneWeekToggle" DockPanel.Dock="Right"
                                      Style="{StaticResource WeekPill}"
                                      Checked="WeekMode_Toggled" Unchecked="WeekMode_Toggled"
                                      AutomationProperties.Name="已完成按周分组"
                                      ToolTip="按周分组">
                            <TextBlock Text="按周" FontSize="12.5"/>
                        </ToggleButton>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="18" Height="18" Margin="0,1,8,0" VerticalAlignment="Center">
                            <Ellipse Fill="{StaticResource DoneGreen}"/>
                            <Path Data="M 5.2 9.3 L 7.9 11.9 L 12.9 6.4" Stroke="White" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <TextBlock Text="已完成" Style="{StaticResource ColumnTitle}" Foreground="{StaticResource Ink}"/>
                        <Border x:Name="DoneCountPill" Style="{StaticResource CountPill}" Background="Transparent">
                            <TextBlock x:Name="DoneCount" Text="0" FontSize="13" Foreground="{StaticResource Muted}"/>
                        </Border>
                      </StackPanel>
                    </DockPanel>

                    <DockPanel x:Name="DoneWeekBar" Margin="2,0,0,8" MinHeight="30" LastChildFill="False" Visibility="Collapsed">
                        <Button x:Name="DoneWeekBack" DockPanel.Dock="Left" Style="{StaticResource GhostButton}"
                                Padding="8,4" Margin="-8,0,0,0" Click="WeekBack_Click" ToolTip="返回 · Esc">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 6 1 L 1 6 L 6 11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="7" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="返回"/>
                            </StackPanel>
                        </Button>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock x:Name="DoneWeekTitle" FontSize="15" FontFamily="{DynamicResource UiFontMedium}" FontWeight="Medium"
                                       Foreground="{StaticResource Ink2}"/>
                            <Border x:Name="DoneWeekTagBorder" Background="{StaticResource AccentSoft}" CornerRadius="9"
                                    Padding="7,1,7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="DoneWeekTag" FontSize="11.5" Foreground="{StaticResource AccentDeep}"/>
                            </Border>
                            <TextBlock x:Name="DoneWeekCount" FontSize="12.5" Foreground="{StaticResource Muted}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Border CornerRadius="14" Background="#E9ECF2" BorderBrush="#DFE3EA" BorderThickness="1"
                            Margin="0,2,0,2" IsHitTestVisible="False"/>
                    <ListBox x:Name="DoneList" Style="{StaticResource ListBoxBare}" Margin="6,8,2,8"
                             ItemContainerStyle="{StaticResource DoneRowItem}" ItemTemplate="{StaticResource DoneRowTemplate}"
                             SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick"/>
                    <TextBlock x:Name="DoneEmpty" Style="{StaticResource EmptyHint}" Text="还没有完成的事项" Foreground="#7C8596"/>
                </Grid>
            </Grid>

        </Grid>
        </Grid>
        </Grid>

        <!-- Drag-to-搁置 layer. Kept in the tree at opacity 0 so a drag never has to
             force a layout pass; hit-test transparent so it can never swallow a click. -->
        <Grid x:Name="DragLayer" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="200"
              Visibility="Visible" Opacity="0" IsHitTestVisible="False" ClipToBounds="True">

            <Grid x:Name="ShelveBin" Width="280" Height="140"
                  HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="BinScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="BinShift" Y="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Rectangle x:Name="BinPlate" RadiusX="24" RadiusY="24" Fill="#FFFCF6"
                           Stroke="#E3C28C" StrokeThickness="1.5" StrokeDashArray="5 3.5">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="#6B4E1C" BlurRadius="30" ShadowDepth="12"
                                          Direction="270" Opacity="0.20"/>
                    </Rectangle.Effect>
                </Rectangle>
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Path x:Name="BinGlyph" Width="30" Height="30" Stretch="Uniform"
                          Data="{StaticResource IconShelve}"
                          Stroke="#C08A2E" StrokeThickness="1.7" Fill="Transparent"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center"/>
                    <TextBlock x:Name="BinLabel" Text="拖到这里搁置" FontSize="12.5"
                               Foreground="#A9741B" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <Canvas x:Name="DragCanvas" ClipToBounds="True"/>
        </Grid>

        <!-- a finished card flies from 未完成 to 已完成 on this layer -->
        <Canvas x:Name="FlyCanvas" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="210"
                IsHitTestVisible="False" ClipToBounds="True"/>

        <!-- ============================================================ answer sheet
             A question is finished by answering it: this card comes up over the list,
             Enter answers and finishes, Shift+Enter breaks the line, Esc keeps a draft. -->
        <Grid x:Name="AnswerLayer" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="220" Visibility="Collapsed"
              Background="#26171C26" MouseLeftButtonDown="AnswerLayer_MouseDown">
            <Border x:Name="AnswerCard" Width="540" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="24" Padding="22,18,22,16" Background="White" CornerRadius="16"
                    RenderTransformOrigin="0.5,0.5" MouseLeftButtonDown="AnswerCard_MouseDown">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="AnswerScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="AnswerShift" X="0" Y="0"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#1B2440" BlurRadius="36" ShadowDepth="10" Direction="270" Opacity="0.18"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="{StaticResource QuestionSoft}" CornerRadius="6" Padding="7,1,8,2" VerticalAlignment="Center">
                            <TextBlock Text="问题" FontSize="12" Foreground="{StaticResource QuestionInk}"
                                       FontFamily="{DynamicResource UiFontMedium}" FontWeight="Medium"/>
                        </Border>
                        <TextBlock x:Name="AnswerMeta" Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <ScrollViewer MaxHeight="132" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <TextBlock x:Name="AnswerQuestion" TextWrapping="Wrap" FontSize="{DynamicResource FsCard}"
                                   LineHeight="{DynamicResource FsCardLine}" Foreground="{StaticResource Ink}"
                                   FontFamily="{DynamicResource UiFontMedium}" FontWeight="Medium"/>
                    </ScrollViewer>
                    <Grid x:Name="AnswerField" Margin="0,14,0,0">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="AnswerNudge" X="0"/>
                        </Grid.RenderTransform>
                        <Border x:Name="AnswerFrame" CornerRadius="10" Background="#F6F7FA"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"/>
                        <TextBox x:Name="AnswerBox" Style="{StaticResource InputBox}" Margin="12,10"
                                 MinHeight="86" MaxHeight="220" TextWrapping="Wrap" AcceptsReturn="True"
                                 FontSize="{DynamicResource FsCard}"
                                 TextChanged="AnswerBox_TextChanged"
                                 GotKeyboardFocus="AnswerBox_FocusChanged" LostKeyboardFocus="AnswerBox_FocusChanged"/>
                        <TextBlock x:Name="AnswerPlaceholder" Text="写回答…" Margin="14,10,14,0"
                                   FontSize="{DynamicResource FsCard}" Foreground="{StaticResource Faint}"
                                   IsHitTestVisible="False" VerticalAlignment="Top"/>
                    </Grid>
                    <DockPanel Margin="0,14,0,0" LastChildFill="True">
                        <Button x:Name="AnswerDone" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                                Content="回答并完成" Margin="8,0,0,0" Click="AnswerDone_Click"/>
                        <Button x:Name="AnswerSave" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                Content="只保存" Click="AnswerSave_Click"/>
                        <TextBlock x:Name="AnswerHint" FontSize="11.5" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
